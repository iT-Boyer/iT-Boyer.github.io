<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>习七</title><link>https://it-boyer.github.io/authors/iTBoyer/</link><description>Recent content on 习七</description><generator>Hugo</generator><language>zh-cn</language><managingEditor>itboyer@qq.com (iTBoyer)</managingEditor><webMaster>itboyer@qq.com (iTBoyer)</webMaster><atom:link href="https://it-boyer.github.io/authors/iTBoyer/index.xml" rel="self" type="application/rss+xml"/><item><title>在elisp 中如何向list 变量添加新元素</title><link>https://it-boyer.github.io/post/%E6%97%A5%E5%BF%97%E9%9A%8F%E7%AC%94/elisp%E8%AF%AD%E6%B3%95/</link><pubDate>Wed, 10 Dec 2025 22:27:00 +0800</pubDate><author>itboyer@qq.com (iTBoyer)</author><guid>https://it-boyer.github.io/post/%E6%97%A5%E5%BF%97%E9%9A%8F%E7%AC%94/elisp%E8%AF%AD%E6%B3%95/</guid><description>&lt;style&gt;
.org-todo {
 font-size: 0.8em;
 font-weight: 700;
}
/* *** Org TODO set to TODO state */
